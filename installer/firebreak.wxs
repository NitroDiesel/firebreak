<!--
  MSI installer for Firebreak (based on simplewall by Henry++), built with WiX v5 on GitHub Actions:
    wix build -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -d Version=4.0.1 installer/firebreak.wxs -o dist/firebreak-4.0.1-setup.msi
  It installs beside the original simplewall, never over it. Filters stay
  installed after uninstall, as with the NSIS setup. Turn filtering off in the app first.
  Keep UpgradeCode fixed so a newer MSI replaces an older one in place,
  including the simplewall (Rust) MSI from before the rename.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
    Name="Firebreak"
    Manufacturer="NitroDiesel"
    Version="$(Version)"
    UpgradeCode="4C674A1A-C5EA-4115-829B-EDF6B1B0DD49"
    Scope="perMachine"
    Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Firebreak is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="firebreak.ico" SourceFile="firebreak.ico" />
    <Property Id="ARPPRODUCTICON" Value="firebreak.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/NitroDiesel/firebreak" />

    <!-- The install wizard, with a license page and a choice of folder. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="payload\license.rtf" />

    <!-- "Start Firebreak" on the last page. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start Firebreak" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#firebreak.exe]" />
    <CustomAction Id="LaunchApplication" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <!-- A running copy holds firebreak.exe open. It runs elevated, so the
         request has to come from the elevated side; the tray window quits the
         app on WM_CLOSE. -->
    <util:CloseApplication Id="CloseFirebreak" Target="firebreak.exe" ElevatedCloseMessage="yes"
                           RebootPrompt="no" TerminateProcess="1" Timeout="5" />

    <!-- On uninstall (not upgrade), remove the startup and skip-UAC tasks. -->
    <SetProperty Id="DeleteStartupTasks" Sequence="execute" Before="DeleteStartupTasks"
                 Value="&quot;[System64Folder]cmd.exe&quot; /c schtasks.exe /Delete /TN Firebreak /F &amp; schtasks.exe /Delete /TN Firebreak-SkipUAC /F &amp; schtasks.exe /Delete /TN simplewall-rust /F &amp; schtasks.exe /Delete /TN simplewall-rust-skipuac /F" />
    <CustomAction Id="DeleteStartupTasks" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="DeleteStartupTasks" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Firebreak">
        <Component Id="App" Bitness="always64">
          <File Id="firebreak.exe" Source="payload\firebreak.exe" KeyPath="yes">
            <Shortcut
              Id="StartMenuShortcut"
              Directory="ProgramMenuFolder"
              Name="Firebreak"
              WorkingDirectory="INSTALLFOLDER"
              Icon="firebreak.ico"
              Advertise="yes" />
          </File>
        </Component>
        <Component Id="AppIcon" Bitness="always64">
          <File Source="payload\firebreak.ico" KeyPath="yes" />
        </Component>
        <Component Id="License" Bitness="always64">
          <File Source="payload\LICENSE" KeyPath="yes" />
        </Component>
        <Component Id="Readme" Bitness="always64">
          <File Source="payload\README.md" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="Firebreak">
      <ComponentRef Id="App" />
      <ComponentRef Id="AppIcon" />
      <ComponentRef Id="License" />
      <ComponentRef Id="Readme" />
    </Feature>
  </Package>
</Wix>
