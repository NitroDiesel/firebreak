<!--
  MSI installer for simplewall (Rust), built with WiX v5 on GitHub Actions:
    wix build -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -d Version=3.9.4 installer/simplewall.wxs -o dist/simplewall-3.9.4-setup.msi
  It installs beside the original simplewall, never over it. Filters stay
  installed after uninstall, as with the NSIS setup. Turn filtering off in the app first.
  Keep UpgradeCode fixed so a newer MSI replaces an older one in place.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
    Name="simplewall (Rust)"
    Manufacturer="NitroDiesel"
    Version="$(Version)"
    UpgradeCode="4C674A1A-C5EA-4115-829B-EDF6B1B0DD49"
    Scope="perMachine"
    Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of simplewall (Rust) is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="simplewall.ico" SourceFile="simplewall.ico" />
    <Property Id="ARPPRODUCTICON" Value="simplewall.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/NitroDiesel/simplewall" />

    <!-- The install wizard, with a license page and a choice of folder. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="payload\license.rtf" />

    <!-- "Start simplewall (Rust)" on the last page. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start simplewall (Rust)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#simplewall.exe]" />
    <CustomAction Id="LaunchApplication" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <!-- A running copy holds simplewall.exe open. It runs elevated, so the
         request has to come from the elevated side; the tray window quits the
         app on WM_CLOSE. -->
    <util:CloseApplication Id="CloseSimplewall" Target="simplewall.exe" ElevatedCloseMessage="yes"
                           RebootPrompt="no" TerminateProcess="1" Timeout="5" />

    <!-- On uninstall (not upgrade), remove the startup and skip-UAC tasks. -->
    <SetProperty Id="DeleteStartupTasks" Sequence="execute" Before="DeleteStartupTasks"
                 Value="&quot;[System64Folder]cmd.exe&quot; /c schtasks.exe /Delete /TN simplewall-rust /F &amp; schtasks.exe /Delete /TN simplewall-rust-skipuac /F" />
    <CustomAction Id="DeleteStartupTasks" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="DeleteStartupTasks" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="simplewall-rust">
        <Component Id="App" Bitness="always64">
          <File Id="simplewall.exe" Source="payload\simplewall.exe" KeyPath="yes">
            <Shortcut
              Id="StartMenuShortcut"
              Directory="ProgramMenuFolder"
              Name="simplewall (Rust)"
              WorkingDirectory="INSTALLFOLDER"
              Icon="simplewall.ico"
              Advertise="yes" />
          </File>
        </Component>
        <Component Id="AppIcon" Bitness="always64">
          <File Source="payload\simplewall.ico" KeyPath="yes" />
        </Component>
        <Component Id="License" Bitness="always64">
          <File Source="payload\LICENSE" KeyPath="yes" />
        </Component>
        <Component Id="Readme" Bitness="always64">
          <File Source="payload\README.md" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="simplewall (Rust)">
      <ComponentRef Id="App" />
      <ComponentRef Id="AppIcon" />
      <ComponentRef Id="License" />
      <ComponentRef Id="Readme" />
    </Feature>
  </Package>
</Wix>
