<!--
  MSI installer for the Rust simplewall port, built with WiX v5 on GitHub Actions:
    wix build -arch x64 -d Version=3.9.2 installer/simplewall.wxs -o dist/simplewall-3.9.2-setup.msi
  Filters stay installed after uninstall, as with the NSIS setup. Remove them in the app first.
  Keep UpgradeCode fixed so a newer MSI replaces an older one in place.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="simplewall"
    Manufacturer="simplewall Rust port"
    Version="$(Version)"
    UpgradeCode="4C674A1A-C5EA-4115-829B-EDF6B1B0DD49"
    Scope="perMachine"
    Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of simplewall is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="simplewall.ico" SourceFile="simplewall.ico" />
    <Property Id="ARPPRODUCTICON" Value="simplewall.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/NitroDiesel/simplewall" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="simplewall">
        <!-- One file per component: the exe has no version resource, so WiX can
             only generate component GUIDs for single-file components. -->
        <Component Id="App" Bitness="always64">
          <File Id="simplewall.exe" Source="payload\simplewall.exe" KeyPath="yes">
            <Shortcut
              Id="StartMenuShortcut"
              Directory="ProgramMenuFolder"
              Name="simplewall"
              WorkingDirectory="INSTALLFOLDER"
              Icon="simplewall.ico"
              Advertise="yes" />
          </File>
        </Component>
        <Component Id="Manifest" Bitness="always64">
          <File Source="payload\simplewall.exe.manifest" KeyPath="yes" />
        </Component>
        <Component Id="AppIcon" Bitness="always64">
          <File Source="payload\simplewall.ico" KeyPath="yes" />
        </Component>
        <Component Id="License" Bitness="always64">
          <File Source="payload\LICENSE" KeyPath="yes" />
        </Component>
        <Component Id="Readme" Bitness="always64">
          <File Source="payload\README.md" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="simplewall">
      <ComponentRef Id="App" />
      <ComponentRef Id="Manifest" />
      <ComponentRef Id="AppIcon" />
      <ComponentRef Id="License" />
      <ComponentRef Id="Readme" />
    </Feature>
  </Package>
</Wix>
